LAB_BIND_HOST=127.0.0.1
POSTGRES_DB=a2a_mcp_lab
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab-local-only
DATABASE_URL=postgresql+psycopg://lab:lab-local-only@postgres:5432/a2a_mcp_lab
CONTROL_PLANE_URL=http://control-plane:8000
CONTROL_PLANE_INTERNAL_TOKEN=lab-internal-dev-token
GATEWAY_BASE_URL=http://gateway:8001
CONFIG_ENCRYPTION_KEY=
MODEL_PROVIDER=mock
MODEL_NAME=lab-agent
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_REQUEST_TIMEOUT=120
A2A_REQUEST_TIMEOUT=300
MCP_REQUEST_TIMEOUT=60
RUN_REQUEST_TIMEOUT=600
MCP_TOOLS_URL=http://mcp-tools:8200
MCP_RESOURCES_URL=http://mcp-resources:8200
MCP_FILE_READER_URL=http://mcp-file-reader:8200
MCP_FILE_WRITER_URL=http://mcp-file-writer:8200
# Match the owner of the shared fixtures/ directory.
MCP_FILE_WRITER_UID=1000
MCP_FILE_WRITER_GID=1000
ROOT_AGENT_MAX_HOP=8
ROOT_AGENT_ALLOWED_TARGETS=worker-agent
ROOT_AGENT_ALLOWED_MCP_SERVERS=mcp-tools,mcp-resources,mcp-file-reader,mcp-file-writer
ROOT_AGENT_ALLOWED_TOOLS=
WORKER_AGENT_MAX_HOP=8
WORKER_AGENT_ALLOWED_TARGETS=worker-agent
WORKER_AGENT_ALLOWED_MCP_SERVERS=mcp-tools,mcp-resources,mcp-file-reader,mcp-file-writer
WORKER_AGENT_ALLOWED_TOOLS=calculator,fixture_http_get,read_file,write_file
MCP_FILE_MAX_BYTES=65536
MCP_FILE_WRITER_MAX_BYTES=65536
